# Application
APP_NAME=payment-service
APP_ENV=development
DEBUG=true
API_KEY=change-me-api-key
API_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payments

# SQLAlchemy async DSN (optional override; built from POSTGRES_* if empty)
DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5432/payments

# Outbox / retry defaults (used from stage 2)
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
MESSAGE_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
RETRY_JITTER_SECONDS=0.5
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
