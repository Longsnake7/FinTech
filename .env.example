# Application
APP_NAME=payment-service
APP_ENV=development
DEBUG=true
API_KEY=change-me-api-key
API_PREFIX=/api/v1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=payment
POSTGRES_PASSWORD=payment
POSTGRES_DB=payments

# SQLAlchemy async DSN (optional override; built from POSTGRES_* if empty)
DATABASE_URL=postgresql+asyncpg://payment:payment@localhost:5432/payments

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=payments
RABBITMQ_QUEUE_PAYMENTS_NEW=payments.new
RABBITMQ_QUEUE_RETRY=payments.retry
RABBITMQ_QUEUE_DLQ=payments.dlq
RABBITMQ_ROUTING_PAYMENTS_NEW=payments.new
RABBITMQ_ROUTING_RETRY=payments.retry
RABBITMQ_ROUTING_DLQ=payments.dlq

# Outbox / retry / gateway
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
MESSAGE_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
RETRY_JITTER_SECONDS=0.5
GATEWAY_SUCCESS_RATE=0.9
GATEWAY_MIN_DELAY_SECONDS=2.0
GATEWAY_MAX_DELAY_SECONDS=5.0
WEBHOOK_TIMEOUT_SECONDS=10.0
